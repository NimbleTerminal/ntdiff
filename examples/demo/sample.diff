@@ -1,9 +1,16 @@
 package main
 
 import (
+    "context"
     "fmt"
+    "time"
 )
 
-func greet(name string) string {
-    return "Hello, " + name
+func greet(ctx context.Context, name string) string {
+    select {
+    case <-ctx.Done():
+        return "Goodbye, " + name
+    case <-time.After(time.Second):
+        return fmt.Sprintf("Hello, %s!", name)
+    }
 }
@@ -20,3 +27,4 @@ func main() {
-    message := greet("world")
+    ctx := context.Background()
+    message := greet(ctx, "world")
     fmt.Println(message)
 }
